<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>News-AI | Smart News Assistant</title>
    <link rel="stylesheet" href="./styles.css">
    <link rel="stylesheet" href="./animation.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <button class="menu-btn" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>

    <div class="sidebar" id="sidebar">
        <button class="close-btn" onclick="toggleSidebar()"><i class="fas fa-times"></i></button>
        <ul>
            <li><a href="#" onclick="displayNews(); toggleSidebar(); return false;"><i class="fas fa-home"></i> Home</a></li>
            <li><a href="#" onclick="toggleSidebar(); return false;"><i class="fas fa-fire"></i> Trending</a></li>
            <li class="has-submenu">
                <a href="#" onclick="toggleSubmenu(this); return false;">
                    <i class="fas fa-list"></i> Categories <i class="fas fa-chevron-down"></i>
                </a>
                <ul class="submenu">
                    <li><a href="#" onclick="fetchCategoryNews('business'); toggleSidebar(); return false;"><i class="fas fa-briefcase"></i> Business</a></li>
                    <li><a href="#" onclick="fetchCategoryNews('health'); toggleSidebar(); return false;"><i class="fas fa-heartbeat"></i> Health</a></li>
                    <li><a href="#" onclick="fetchCategoryNews('politics'); toggleSidebar(); return false;"><i class="fas fa-landmark"></i> Politics</a></li>
                    <li><a href="#" onclick="fetchCategoryNews('industry'); toggleSidebar(); return false;"><i class="fas fa-industry"></i> Industry</a></li>
                    <li><a href="#" onclick="fetchCategoryNews('technology'); toggleSidebar(); return false;"><i class="fas fa-microchip"></i> Tech</a></li>
                </ul>
            </li>
            <li><a href="#" onclick="displaySavedNews(); toggleSidebar(); return false;"><i class="fas fa-bookmark"></i> Saved News</a></li>
            <li><a href="#" onclick="toggleSidebar(); return false;"><i class="fas fa-info-circle"></i> About</a></li>
            
            <!-- API Key Configuration Section -->
            <li class="api-keys-section">
                <div class="api-section-header">
                    <i class="fas fa-key"></i> API Configuration
                </div>
                <div class="api-key-input">
                    <label for="geminiKey">Gemini API Key:</label>
                    <div class="input-group">
                        <input type="password" id="geminiKey" placeholder="Enter Gemini Key">
                        <button onclick="setGeminiApiKey(document.getElementById('geminiKey').value)">
                            <i class="fas fa-check"></i>
                        </button>
                    </div>
                </div>
                <div class="api-key-input">
                    <label for="perplexityKey">Perplexity API Key:</label>
                    <div class="input-group">
                        <input type="password" id="perplexityKey" placeholder="Enter Perplexity Key">
                        <button onclick="setPerplexityApiKey(document.getElementById('perplexityKey').value)">
                            <i class="fas fa-check"></i>
                        </button>
                    </div>
                </div>
            </li>
        </ul>
    </div>

    <header>
        <h1><i class="fas fa-newspaper"></i> News-AI: Your Smart News Assistant</h1>
    </header>

    <main>
        <div class="news-container" id="news">
            <div class="loading-news">
                <div class="news-loader"><div></div><div></div></div>
                <p>Fetching the latest news for you...</p>
            </div>
        </div>
    </main>

    <footer>
        <p>&copy; 2025 News-AI | <i class="fas fa-code"></i> Built with <i class="fas fa-heart"></i> by Developers</p>
    </footer>

    <script src="scripts.js"></script>
</body>
</html>
